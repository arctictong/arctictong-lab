# Copy to `credentials.env` next to docker-compose.yml, fill in real values, and
# never commit it.  The deploy (.gitignore also) excludes credentials.env, so a
# `git add -A` here cannot pick it up.
#
# The server reads this file directly rather than reading process.env.  That is
# deliberate: the compose file used to list AUTH_PASS as a literal in its
# `environment:` block, and a literal always wins over ${VAR} substitution -- so
# a .env sitting beside it had no effect at all, and a login rejection looked
# exactly like a wrong password.  One file, read by the code, is unambiguous.
#
# The container sees this file at /app/credentials.env via a read-only bind
# mount.  There is no fallback in auth.js on purpose: a missing JWT_SECRET used
# to mean the source-code constant was used instead, which let anyone who had
# read the source mint a valid `admin` session.

# Login username for the web UI.
AUTH_USER=admin

# Login password.  Generate one rather than inventing it:
#   openssl rand -base64 24
AUTH_PASS=replace-with-a-generated-password

# Signing key for the 30-day session tokens.  Rotating it logs everyone out,
# which is the point.  Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-characters
