server {
    listen 9080 default_server;
    server_name _;

    root /var/www/headscale-ui;
    index index.html;

    # marker so "which box answered?" is a curl away, forever
    # 106 and 109 run identical nginx and both send `Server: nginx/1.x`
    add_header X-Served-By ct109 always;

    # --- dashboard (ticket 03/04) ------------------------------------------------
    # The Python app on 127.0.0.1:8001 owns the API and the /dashboard/ page.
    # Loopback-only bind, so nothing on the LAN reaches it except through here.

    location /api/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # /api/services probes up to a dozen hosts with a 5s timeout each; the
        # default 60s read timeout is generous enough, but the connect one is not.
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location /dashboard/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # --- the original headscale UI, untouched ---------------------------------
    # `/` deliberately still serves the original headscale UI.  The dashboard is
    # at /dashboard/ (decided in ticket 03: `/` on the public host is the path
    # that reaches headscale's own API, so it cannot be taken).
    #
    # Note the two `/api/` meanings, which are easy to confuse: the `location
    # /api/` block above is the *dashboard's* API.  headscale's own API is never
    # reachable through 109 -- NPM sends those requests straight to CT 106.

    # `/` itself has nothing to serve: the docroot holds only `web/`, so the
    # bare try_files matched the directory and nginx answered 403 (there is no
    # index.html at the root).  The UI lives under /web/, so send a LAN visitor
    # there.  An exact match wins over `location /` below, and the public host's
    # `/` is untouched because NPM never routes it here.
    location = / {
        return 302 /web/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /web/ {
        try_files $uri $uri/ /web/index.html;
    }
}
